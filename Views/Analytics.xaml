<Window x:Class="MiniSCADA.Analytics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniSCADA"
        mc:Ignorable="d"
        Title="Analytics" Height="800" Width="1300"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#f1fff1">

    <Window.Resources>
        <Style x:Key="SensorLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,15,10,15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ConnButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#cbffbf"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="10" 
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnStyle1" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="Padding" Value="12,20" />
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SensorNames" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="{x:Type DatePicker}">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Border Background="White" 
                  CornerRadius="8" 
                  BorderBrush="#DDDDDD" 
                  BorderThickness="1" 
                  Padding="2">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" Color="#EEE" ShadowDepth="1"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox" 
                                     Grid.Column="0" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0,0,0"
                                     SelectionBrush="#0984E3"/>

                                <Button x:Name="PART_Button" 
                          Grid.Column="1" 
                          Width="30"
                          Background="Transparent" 
                          BorderThickness="0"
                          Cursor="Hand">
                                    <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"  Margin="0,0,0,10" >
            <TextBlock Text="SCADA Lite"
               FontSize="28"
               FontWeight="DemiBold"
               HorizontalAlignment="Center" Width="156"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#cbffbf">
                <Image Source="/images/SCADA_Logo-removebg-preview.png" Height="75"></Image>
                <Separator Margin="10,10" Background="LightGreen"></Separator>

                <Button Content="Dashboard" Style="{StaticResource BtnStyle1}" x:Name="Mainbtn" Click="Mainbtn_Click" />
                <Button Content="Alarms" Style="{StaticResource BtnStyle1}" x:Name="AlarmsBtn" Click="AlarmsBtn_Click" />
                <Button Content="Sensors" Style="{StaticResource BtnStyle1 }" x:Name="Sensorsbtn" Click="Sensorsbtn_Click"/>
                <Button Content="Data view" Style="{StaticResource BtnStyle1}" x:Name="DataBtn" Click="DataBtn_Click" />

                <Separator Margin="10,10" Background="LightGreen"/>

                <Button Content="Setting" Style="{StaticResource BtnStyle1}" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="Data panel" FontSize="28" HorizontalAlignment="Center" FontWeight="Bold" />
                </DockPanel>

                <Border BorderThickness="1" BorderBrush="Green" CornerRadius="8" Background="White" Margin="3,10,3,0" Grid.Row="1">
                    <lvc:CartesianChart Series="{Binding SeriesCollection}" 
                            LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Timp" Labels="{Binding Labels}"></lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Valoare" LabelFormatter="{Binding YFormatter}"></lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>

                <Border Grid.Row="2" BorderThickness="1" BorderBrush="Green" CornerRadius="8" Background="White" Margin="3,10,3,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="Analyses" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0"/>
                        </DockPanel>

                        <DockPanel Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="10,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="10,15,10,10">
                                            <TextBlock Text="Data Range Picker" FontSize="18" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0" />

                                        </DockPanel>

                                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                                            <Button Margin="0,10" Width="140" Content="Last  measures" Style="{StaticResource ConnButton}"/>
                                            <Button Margin="0,10" Width="140" Content="Last five measures" Style="{StaticResource ConnButton}"/>
                                            <Button Margin="0,10" Width="140" Content="Last ten measures" Style="{StaticResource ConnButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>

                                <DockPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="5,15,10,17">
                                            <TextBlock Text="More values" FontSize="18" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0" />
                                                
                                        </DockPanel>
                                        <DockPanel Grid.Row="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Select Operation" FontSize="15" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,0" />
                                                    <ComboBox x:Name="operationComboBox" Width="250" Background="Wheat" FontSize="15" Margin="10,0,10,0">
                                                        <ComboBoxItem Content="Average"/>
                                                        <ComboBoxItem Content="Min"/>
                                                        <ComboBoxItem Content="Max"/>
                                                        <ComboBoxItem Content="Deviation"/>
                                                    </ComboBox>
                                                   
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Select Sensor      " FontSize="15" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,0" />
                                                    <ComboBox x:Name="sensorComboBox" Width="250" Background="Wheat" FontSize="15" Margin="10,0,10,0">
                                                        <ComboBoxItem Content="Temperatura"/>
                                                        <ComboBoxItem Content="Umiditate"/>
                                                        <ComboBoxItem Content="Lumina"/>
                                                    </ComboBox>
                                                    
                                                </StackPanel>

                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Result                             " FontSize="15" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,0" />
                                                    <TextBlock x:Name="TxtRezultatMedia" 
                                                           Text="0.00" 
                                                           FontWeight="Bold" 
                                                           Foreground="Blue" 
                                                           TextAlignment="Center"
                                                           Margin="5,0,0,0" 
                                                           VerticalAlignment="Center"/>     
                                                </StackPanel>



                                                <StackPanel Grid.Row="2">
                                                    <Button Margin="0,10" Width="140" Content="Calculate" x:Name="CalculsBtn" Click="CalculsBtn_Click" Style="{StaticResource ConnButton}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                                <DockPanel Grid.Column="2" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="10,15,10,10">
                                            <TextBlock Text="More values" FontSize="18" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="Select Sensor: " Margin="20,0,10,0" FontSize="17" FontWeight="DemiBold"/>
                                            <ComboBox x:Name="SensorDBCombobox" Width="200" Background="Wheat" FontSize="15" Margin="10,0,10,0">
                                                <ComboBoxItem Content="Temperatura"/>
                                                <ComboBoxItem Content="Umiditate"/>
                                                <ComboBoxItem Content="Lumina"/>
                                             </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2">
                                            <Button Margin="0,10" Width="140" x:Name="SelectSensor" Click="SelectSensor_Click" Content="Select" Style="{StaticResource ConnButton}"/>
                                        </StackPanel>
                                            
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>

                    </Grid>

                </Border>


            </Grid>

        </Grid>

        <TextBlock Grid.Row="2"
      Text="© 2025 Nume proiect by Edy"
      FontSize="20"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Foreground="Black"
      Margin="0,10,0,0"/>



    </Grid>
</Window>
